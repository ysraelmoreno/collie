{
  "commands": [
    { "name": "board", "summary": "Lê o quadro inteiro: colunas e cartões (com --archived, também os arquivados).",
      "runs": "http", "http": { "method": "GET", "path": "/api/board" }, "timeout": 30,
      "params": [ { "name": "archived", "type": "flag", "help": "inclui cartões arquivados" } ] },
    { "name": "list-cards", "summary": "Lista cartões ativos, filtrando por coluna, rótulo, responsável, tipo, prioridade ou texto.",
      "runs": "http", "http": { "method": "GET", "path": "/api/cards" }, "timeout": 30,
      "params": [ { "name": "column", "type": "string", "help": "todo, doing, review ou done" },
                  { "name": "label", "type": "string", "help": "um rótulo" },
                  { "name": "assignee", "type": "string", "help": "responsável" },
                  { "name": "q", "type": "string", "help": "texto no título, corpo ou rótulos" },
                  { "name": "type", "type": "string", "help": "tipo: impl, bug, refactor, spike, test, docs ou chore" },
                  { "name": "priority", "type": "string", "help": "prioridade: high, medium ou low" } ] },
    { "name": "get-card", "summary": "Lê um cartão pelo id, com comentários.",
      "runs": "http", "http": { "method": "GET", "path": "/api/card" }, "timeout": 30,
      "params": [ { "name": "id", "type": "string", "required": true, "positional": true, "help": "id do cartão (8 hex)" } ] },
    { "name": "create-card", "summary": "Cria um cartão (padrão: coluna todo).",
      "runs": "http", "http": { "method": "POST", "path": "/api/card/create" }, "timeout": 15,
      "params": [ { "name": "title", "type": "string", "required": true, "help": "título, 1 a 200 caracteres" },
                  { "name": "body", "type": "string", "help": "descrição, até 8000 caracteres" },
                  { "name": "column", "type": "string", "help": "todo, doing, review ou done" },
                  { "name": "labels", "type": "string", "help": "rótulos separados por vírgula" },
                  { "name": "assignee", "type": "string", "help": "responsável" },
                  { "name": "type", "type": "string", "help": "tipo: impl, bug, refactor, spike, test, docs ou chore (padrão impl)" },
                  { "name": "priority", "type": "string", "help": "prioridade: high, medium ou low (padrão medium)" },
                  { "name": "by", "type": "string", "help": "quem está escrevendo (texto livre)" } ] },
    { "name": "update-card", "summary": "Muda título, corpo, rótulos, responsável, tipo ou prioridade de um cartão.",
      "runs": "http", "http": { "method": "POST", "path": "/api/card/update" }, "timeout": 15,
      "params": [ { "name": "id", "type": "string", "required": true, "positional": true, "help": "id do cartão" },
                  { "name": "title", "type": "string", "help": "novo título" },
                  { "name": "body", "type": "string", "help": "nova descrição" },
                  { "name": "labels", "type": "string", "help": "rótulos separados por vírgula (substitui os atuais)" },
                  { "name": "assignee", "type": "string", "help": "novo responsável" },
                  { "name": "type", "type": "string", "help": "novo tipo: impl, bug, refactor, spike, test, docs ou chore" },
                  { "name": "priority", "type": "string", "help": "nova prioridade: high, medium ou low" },
                  { "name": "by", "type": "string", "help": "quem está escrevendo" } ] },
    { "name": "move-card", "summary": "Move um cartão para outra coluna (ou reordena na mesma).",
      "runs": "http", "http": { "method": "POST", "path": "/api/card/move" }, "timeout": 15,
      "params": [ { "name": "id", "type": "string", "required": true, "positional": true, "help": "id do cartão" },
                  { "name": "column", "type": "string", "required": true, "help": "todo, doing, review ou done" },
                  { "name": "index", "type": "int", "help": "posição na coluna, a partir de 0 (sem ela: fim)" },
                  { "name": "by", "type": "string", "help": "quem está movendo" } ] },
    { "name": "comment-card", "summary": "Comenta num cartão.",
      "runs": "http", "http": { "method": "POST", "path": "/api/card/comment" }, "timeout": 15,
      "params": [ { "name": "id", "type": "string", "required": true, "positional": true, "help": "id do cartão" },
                  { "name": "text", "type": "string", "required": true, "help": "comentário, 1 a 2000 caracteres" },
                  { "name": "by", "type": "string", "help": "quem está comentando" } ] },
    { "name": "archive-card", "summary": "Arquiva um cartão (reversível com restore-card).",
      "runs": "http", "http": { "method": "POST", "path": "/api/card/archive" }, "timeout": 15,
      "params": [ { "name": "id", "type": "string", "required": true, "positional": true, "help": "id do cartão" },
                  { "name": "by", "type": "string", "help": "quem está arquivando" } ] },
    { "name": "restore-card", "summary": "Tira um cartão do arquivo.",
      "runs": "http", "http": { "method": "POST", "path": "/api/card/restore" }, "timeout": 15,
      "params": [ { "name": "id", "type": "string", "required": true, "positional": true, "help": "id do cartão" },
                  { "name": "by", "type": "string", "help": "quem está restaurando" } ] },
    { "name": "events", "summary": "Diário de mudanças do quadro depois de um número de sequência.",
      "runs": "http", "http": { "method": "GET", "path": "/api/events" }, "timeout": 30,
      "params": [ { "name": "since", "type": "int", "help": "só eventos depois deste seq (padrão 0; até 200 por vez)" } ] }
  ],
  "eventStream": "/api/stream",
  "eventDiff": "events",
  "events": ["quadro.event"]
}
