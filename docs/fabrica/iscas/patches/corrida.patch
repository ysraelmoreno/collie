+import Foundation
+
+/// Conta eventos vindos de várias threads.
+public final class Contador: @unchecked Sendable {
+    public private(set) var total = 0
+    public init() {}
+    public func registrar(_ n: Int) {
+        DispatchQueue.concurrentPerform(iterations: n) { _ in total += 1 }
+    }
+}
