{
  "version": 1,
  "gate": "bash scripts/gate.sh",
  "precheck": "swift build --build-tests",
  "smoke": "swift build",
  "areas": {
    "core": "scripts/check-feature.sh CoreTests"
  },
  "factory": {
    "version": 1,
    "static": {
      "ratchets": [
        { "name": "todo", "measure": "set -o pipefail; [ -d Sources ] || { echo 'todo: a pasta Sources não existe; ajuste o measure' >&2; exit 1; }; { grep -rIc TODO Sources || [ $? = 1 ]; } | awk -F: '$2 > 0 { print \"todo\", $1, $2 }'", "baseline": "scripts/todo-baseline.txt" }
      ]
    },
    "review": { "personas": ["correcao", "testes", "simplicidade", "seguranca"], "threshold": "major", "callOwner": true },
    "guardrails": { "budgetSeconds": 1800, "maxTries": 3, "destructive": ["rm -rf", "git push --force", "git reset --hard"], "land": "manual", "autoLandPerDay": 3 }
  }
}
