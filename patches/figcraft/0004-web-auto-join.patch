 //! `#join=` in the page's URL.
 
-use crate::query::join_link;
+use crate::query::{join_link, orq_auto};
 
 #[test]
 fn join_takes_the_rest_of_the_fragment() {
@@ -27,3 +27,18 @@ fn an_overlong_link_is_ignored() {
     assert_eq!(join_link(&long), None);
     assert_eq!(join_link(&format!("#join={}", "é".repeat(4000))), None, "length counts bytes");
 }
+
+#[test]
+fn orq_auto_reads_only_entries_before_join() {
+    let link = "figcraft://join?host=h&file=f&token=t";
+    assert!(orq_auto(&format!("#orq=1&join={link}")));
+    assert!(orq_auto("orq=1&join=x"), "no leading #");
+    assert_eq!(join_link(&format!("#orq=1&join={link}")), Some(link), "the link is unchanged");
+    assert!(!orq_auto(&format!("#join={link}")));
+    assert!(!orq_auto("#join=figcraft://join?orq=1&x=1"), "inside the link it doesn't count");
+    assert!(!orq_auto("#join=x&orq=1"), "after join it is part of the link");
+    assert!(!orq_auto("#join=a&orq=1&join=b"), "a leading join takes it all, like join_link");
+    assert!(!orq_auto("#orq=10&join=x"));
+    assert!(!orq_auto("#xorq=1&join=x"));
+    assert!(!orq_auto("#orq=1"), "nothing to join");
+}
