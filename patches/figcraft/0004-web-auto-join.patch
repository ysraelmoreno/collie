+/// Join the session `link` names right away, as the Join dialog's button does: only for a link the
+/// page's own host put there (Orq's Design panel), never one the system hands the app.
+pub fn join_invite(app: &mut FigApp, link: &str) {
+    app.run("collab.join", json!({"code": link.trim()}));
+}
