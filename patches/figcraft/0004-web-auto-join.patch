diff --git a/apps/figcraft-web/src/query.rs b/apps/figcraft-web/src/query.rs
index befeb36..e7244c5 100644
--- a/apps/figcraft-web/src/query.rs
+++ b/apps/figcraft-web/src/query.rs
@@ -13,3 +13,13 @@ pub fn join_link(fragment: &str) -> Option<&str> {
     let start = if fragment.starts_with("join=") { 0 } else { fragment.find("&join=")? + 1 };
     fragment.get(start + "join=".len()..).filter(|link| !link.is_empty() && link.len() <= MAX)
 }
+
+/// `#orq=1&join=<link>`: the page is Orq's Design panel, whose host put the link there itself, so the
+/// session is joined without the confirmation dialog. Only entries before `join=` count (the link
+/// takes the rest of the fragment, and an `orq=1` inside it is the link's own).
+pub fn orq_auto(fragment: &str) -> bool {
+    let fragment = fragment.strip_prefix('#').unwrap_or(fragment);
+    // the same `join=` entry `join_link` reads: a leading one leaves nothing before it
+    let Some(end) = fragment.find("&join=").filter(|_| !fragment.starts_with("join=")) else { return false };
+    fragment[..end].split('&').any(|entry| entry == "orq=1")
+}
