+thread_local! {
+    /// The running app's context: [`collie_add_font`] repaints with it.
+    static CTX: std::cell::RefCell<Option<egui::Context>> = const { std::cell::RefCell::new(None) };
+}
+
+/// Collie: adds a font file (TTF/OTF/TTC, variable ok) to the font database at run time, then lays
+/// text out again. False when it holds no usable face.
+#[wasm_bindgen::prelude::wasm_bindgen]
+pub fn collie_add_font(bytes: &[u8]) -> bool {
+    let added = !figcraft_text::db().write().unwrap_or_else(std::sync::PoisonError::into_inner).add_bytes(bytes.to_vec()).is_empty();
+    if added {
+        figcraft_text::clear_layout_cache();
+        CTX.with(|c| {
+            if let Some(ctx) = c.borrow().as_ref() {
+                ctx.request_repaint();
+            }
+        });
+    }
+    added
+}
+
 fn query() -> String {
     web_sys::window().and_then(|w| w.location().search().ok()).unwrap_or_default()
 }
